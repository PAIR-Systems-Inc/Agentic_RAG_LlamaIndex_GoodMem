      "agent": "workflow",
      "case": "cross_space",
      "question": "Using details from both docs, explain how a LangGraph StateGraph differs from a LangChain agent's tool-calling loop. Cite both sources.",
      "passed": true,
      "tool_calls": [
        {
          "name": "langgraph_docs_tool",
          "args": {
            "input": "StateGraph"
          },
