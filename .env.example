# GoodMem REST server root (no /v1, /mcp, or gRPC port).
GOODMEM_BASE_URL=http://localhost:8088
GOODMEM_API_KEY=

# Existing embedder ID OR a key to register an embedder during setup.
GOODMEM_EMBEDDER_ID=
GOODMEM_EMBEDDING_MODEL=embed-v4.0
EMBEDDING_API_KEY=
COHERE_API_KEY=

# Cohere uses the same key for chat, embeddings and optional reranking.
CHAT_PROVIDER=cohere
CHAT_MODEL=command-a-03-2025
GROQ_API_KEY=
# Optional Groq chat: CHAT_PROVIDER=groq, CHAT_MODEL=openai/gpt-oss-120b

# Optional existing reranker, or run setup --with-reranker with COHERE_API_KEY.
GOODMEM_RERANKER_ID=
GOODMEM_RERANKER_MODEL=rerank-v3.5
GOODMEM_NAMESPACE=agentic-rag-llamaindex-goodmem
GOODMEM_TIMEOUT=120
GOODMEM_INGEST_TIMEOUT=600
